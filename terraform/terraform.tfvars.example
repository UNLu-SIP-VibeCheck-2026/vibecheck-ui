# =============================================================================
# Example variable values — copy to terraform.tfvars and fill in your values
# =============================================================================
# cp terraform.tfvars.example terraform.tfvars

project_id      = "my-gcp-project-id"
region          = "us-central1"
service_name    = "vibecheck-ui"
image_tag       = "latest"
api_backend_url = "https://vibecheck-core.up.railway.app"

# Scaling
min_instance_count = 0
max_instance_count = 3

# Resources per instance
cpu    = "1"
memory = "256Mi"

# Optional: set a custom domain (leave empty to skip)
# domain = "vibecheck.example.com"
